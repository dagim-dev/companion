# NOVA Companion — environment variables
# Copy to .env and fill in values: cp .env.example .env

# --- Required ---

# OpenAI API key (chat, cognition, memory extraction, Whisper STT)
OPENAI_API_KEY=sk-your-key-here

# --- Auth ---

# JWT signing secret (required when ENV is not development; dev uses a built-in local-only secret if unset)
JWT_SECRET=change-me-in-production

# Token lifetime in minutes (default: 10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# development | production (non-development requires JWT_SECRET at startup)
ENV=development

# --- Database ---

# SQLite file path (default: memory.db in project root)
DATABASE_PATH=memory.db

# --- CORS ---

# Comma-separated allowed origins for the API
# Include every browser origin that will call the API directly in production.
# For local production-like smoke tests on another port, add that origin too (e.g. http://127.0.0.1:3001).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Voice (optional) ---

# ElevenLabs API key (TTS only — this is NOT the voice ID)
ELEVENLABS_API_KEY=your-elevenlabs-key

# Voice ID from ElevenLabs dashboard (Voices → ⋮ → Copy voice ID)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Keep false for the first deployment until voice behavior is explicitly verified
VOICE_ENABLED=false

# --- Logging ---

# DEBUG | INFO | WARNING | ERROR (default: INFO in development, WARNING in production)
LOG_LEVEL=INFO

# --- CLI only ---

# User ID scope for terminal mode (main.py); not a registered account
CLI_USER_ID=local-dev

# --- Frontend (separate file) ---
# See frontend/.env.local.example for:
#   NEXT_PUBLIC_API_URL  — API base URL (set this explicitly in production)
#   NEXT_PUBLIC_DEV_TOKEN — skip login UI with a pre-made JWT (local testing)
#   BACKEND_URL — used by optional SSE proxy route (frontend/src/app/v1/chat/stream/route.ts)
